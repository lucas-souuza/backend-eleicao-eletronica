,"example":"PUNI"}},"required":["id","nome","sigla"]},"CadastrarPartidoDto":{"type":"object","properties":{"nome":{"type":"string","description":"Nome do partido.","minLength":1,"maxLength":100,"example":"Partido da Universidade"},"sigla":{"type":"string","description":"Sigla do partido. É única e salva em letras maiúsculas.","minLength":1,"maxLength":15,"example":"PUNI"}},"required":["nome","sigla"]},"CadastrarCandidaturaDto":{"type":"object","properties":{"candidatoId":{"type":"string","description":"ID do candidato (devolvido por POST /candidatos).","pattern":"^[1-9]\\d*$","example":"1"},"eleicaoId":{"type":"string","description":"ID da eleição. A eleição precisa estar AGENDADA.","pattern":"^[1-9]\\d*$","example":"1"},"cargoId":{"type":"string","description":"ID do cargo. Na carga inicial: 1 = Deputado Estadual, 2 = Deputado Federal, 3 = Senador, 4 = Governador, 5 = Presidente da República.","pattern":"^[1-9]\\d*$","example":"4"},"partidoId":{"type":"string","description":"ID do partido (veja GET /partidos).","pattern":"^[1-9]\\d*$","example":"1"},"numeroEleitoral":{"type":"string","description":"Número do candidato na urna (1 a 10 dígitos). Não pode se repetir no mesmo cargo e eleição.","pattern":"^\\d{1,10}$","maxLength":10,"example":"45"}},"required":["candidatoId","eleicaoId","cargoId","partidoId","numeroEleitoral"]},"CandidaturaRespostaDto":{"type":"object","properties":{"id":{"type":"string","description":"ID da candidatura. É o valor usado em POST /votos.","example":"1"},"candidatoId":{"type":"string","description":"ID do candidato.","example":"1"},"eleicaoId":{"type":"string","description":"ID da eleição.","example":"1"},"cargoId":{"type":"number","description":"ID do cargo.","example":4},"partidoId":{"type":"number","description":"ID do partido.","example":1},"numeroEleitoral":{"type":"string","description":"Número do candidato na urna.","example":"45"}},"required":["id","candidatoId","eleicaoId","cargoId","partidoId","numeroEleitoral"]},"InscreverEleito